{
  "name": "ttw-translation-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {"node": ">=22.13"},
  "scripts": {
    "dev": "vite --config admin/vite.config.ts",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "dev:web": "tsx watch apps/web/src/main.ts",
    "build": "tsc -p tsconfig.server.json && vite build --config admin/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p admin/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"{admin/src,apps,packages,scripts,tests}/**/*.{ts,tsx,css,mjs}\"",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "migrate": "tsx scripts/setup.ts migrate",
    "seed": "tsx scripts/setup.ts seed",
    "start:api": "node dist/apps/api/src/main.js",
    "start:worker": "node dist/apps/worker/src/main.js",
    "start:web": "node dist/apps/web/src/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "bullmq": "^5.58.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sanitize-html": "^2.16.0",
    "eslint": "^9.35.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.0"
  }
}
